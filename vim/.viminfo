"9	LINE	0
	# If you come from bash you might have to change your $PATH.
	# export PATH=$HOME/bin:/usr/local/bin:$PATH
	
	# zmodload zsh/zprof  # Uncomment to profile startup
	
	# =============================================
	# FIX 1: Run compinit once with caching, then
	# make it a no-op so oh-my-zsh can't re-run it.
	# This saves ~600ms on every shell startup.
	# =============================================
	autoload -Uz compinit
	compinit -C
	compinit () { }
	
	#---------------------------------------------#
	# PATH
	#---------------------------------------------#
	
	export BEACON_MAINNET_API_KEY="TTJIQnRtUDhtUWxYM0M5MVlldXZBOThhMmVYdQ"
	export BEACON_PRATER_API_KEY="TTJIQnRtUDhtUWxYM0M5MVlldXZBOThhMmVYdQ"
	export HISTFILE=~/.zsh_history
	export HISTFILESIZE=1000000000
	export HISTSIZE=1000000000
	# append immediately
	setopt INC_APPEND_HISTORY
	export HISTTIMEFORMAT="[%F %T] "
	# timestamps
	setopt EXTENDED_HISTORY
	# dont write duplicates
	#setopt HIST_IGNORE_ALL_DUPS
	
	export DISABLE_AUTO_UPDATE=true
	export ZSH="/Users/mike/.oh-my-zsh"
	export PATH=/usr/local/Cellar:$PATH
	export PATH=$PATH:$HOME/.darknode/bin
	export PATH=$PATH:/Users/mike/blockchain/sre-scripts
	export PATH=$PATH:/Users/mike/bin
	export PATH=$PATH:/Users/mike/Library/Python/3.9/bin
	export GPG_TTY=$(tty)
	export PGDATA="/Users/mike/postgresDB"
	export EDITOR=/usr/bin/vim
	export VISUAL=/usr/bin/vim
	
	export MOONBEAM_NODE_PRIMARY_RPC=https://rpc.ankr.com/moonbeam
	export OPTIMISM_NODE_PRIMARY_RPC=https://mainnet.optimism.io
	export DATABASE_URL=postgres://defi-balances-user:12345@127.0.0.1/defi-balances
	export AVALANCHE_NODE_PRIMARY_RPC=https://api.avax.network/ext/bc/C/rpc
